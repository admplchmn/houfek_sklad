# Zkopírujte do .env a vyplňte. Soubor .env nikdy nepatří do repozitáře (je v .gitignore).
# Úplný přehled proměnných a jejich provozních hodnot: docs/provoz.md

# --- Databáze --------------------------------------------------------------------------
# Vývoj: testovací SQL Server v Dockeru (blok níže) nebo SQL Server na vašem PC (Express: localhost\SQLEXPRESS).
HOUFEK_DB_SERVER=localhost
# Vlastní prázdná databáze aplikace. Databázi PowerKey nikdy nepoužívat.
HOUFEK_DB_NAZEV=HoufekSklad_DEV
# Účet aplikace (v provozu jen role app_sklad)
HOUFEK_DB_UZIVATEL=
HOUFEK_DB_HESLO=
# Účet pro `flask db upgrade` (db_owner). Prázdné = stejný účet jako aplikace (jen ve vývoji).
HOUFEK_DB_UZIVATEL_MIGRACE=
HOUFEK_DB_HESLO_MIGRACE=
HOUFEK_DB_OVLADAC=ODBC Driver 18 for SQL Server
# Šifrování je na SRVACC01 povinné; interní certifikát → důvěřovat (jako v SSMS)
HOUFEK_DB_SIFROVAT=1
HOUFEK_DB_DUVEROVAT_CERTIFIKATU=1
# Časové limity: přihlášení k DB (s), jeden dotaz (s), čekání na zámek pozice (ms)
HOUFEK_DB_LIMIT_PRIHLASENI_S=15
HOUFEK_DB_LIMIT_DOTAZU_S=30
HOUFEK_DB_LIMIT_ZAMKU_MS=5000

# --- Testovací SQL Server v Dockeru (integrační testy, docs/vyvoj.md 1.1) --------------
# Prázdný server = integrační testy se přeskočí. Pro Docker: localhost a heslo účtu sa (aspoň 8 znaků,
# velká i malá písmena a číslice, bez znaku $). Stejné heslo nastaví docker compose kontejneru.
HOUFEK_TEST_DB_SERVER=
HOUFEK_TEST_DB_NAZEV=HoufekSklad_TEST
HOUFEK_TEST_DB_UZIVATEL=sa
HOUFEK_TEST_DB_HESLO=
HOUFEK_TEST_DB_DUVEROVAT_CERTIFIKATU=1

# --- Aplikace --------------------------------------------------------------------------
# Vývoj: přihlášení bez PINu, Swagger, cookie i bez HTTPS. V provozu vždy 0.
HOUFEK_VYVOJ=1
# Podpis session cookie. V provozu povinný, aspoň 32 znaků:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Ve vývoji může zůstat prázdný (vygeneruje se při každém startu).
HOUFEK_TAJNY_KLIC=
# Při startu ověřit ostrovy proti databázi (tabulky, pohledy, oprávnění)
HOUFEK_KONTROLA_DB_PRI_STARTU=0
# Soubor logu (rotace 10 × 10 MB). Prázdné = jen standardní výstup.
HOUFEK_LOG_SOUBOR=
